PORT=3000
NODE_ENV=development
DATABASE_PATH=./widget-platform.db
# Comma-separated exact origins allowed to embed public widgets.
WIDGET_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# In-memory public widget submission limiter (per client IP, per Node process).
WIDGET_SUBMISSION_RATE_WINDOW_MS=900000
WIDGET_SUBMISSION_RATE_LIMIT=10
# Per-provider geolocation request timeout in milliseconds.
GEOLOCATION_TIMEOUT_MS=1200
# SQLite background job worker settings.
BACKGROUND_JOB_POLL_INTERVAL_MS=1000
BACKGROUND_JOB_MAX_ATTEMPTS=5
BACKGROUND_JOB_RETRY_BASE_MS=1000
BACKGROUND_JOB_RETRY_MAX_MS=3600000
BACKGROUND_JOB_LEASE_MS=30000
